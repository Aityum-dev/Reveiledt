<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1020"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Réveil EDT"
            android:textColor="#E8E9F5"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- État -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#F0FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/checks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Cette semaine -->
        <TextView
            style="@style/Section"
            android:text="Cette semaine" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Touche 🔔 pour couper le réveil un jour précis (malade, grève...)"
            android:textColor="#8A8FB3"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Mes réveils -->
        <TextView
            style="@style/Section"
            android:text="Mes réveils" />

        <LinearLayout
            android:id="@+id/alarms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/newOffset"
                style="@style/Field"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="ex : 1h30, 1h, 40"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLength="6" />

            <Button
                android:id="@+id/addOffset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="#F5B14C"
                android:text="+ Ajouter"
                android:textAllCaps="false"
                android:textColor="#1A1205"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Réglages -->
        <TextView
            style="@style/Section"
            android:text="Réglages" />

        <Switch
            android:id="@+id/enabled"
            style="@style/Toggle"
            android:text="Réveil actif" />

        <Switch
            android:id="@+id/persistent"
            style="@style/Toggle"
            android:text="Notification permanente (verte / rouge)" />

        <Switch
            android:id="@+id/dailyNotif"
            style="@style/Toggle"
            android:text="Notification de vérification à 19h" />

        <TextView
            style="@style/Label"
            android:text="Lien iCal de ton emploi du temps" />

        <EditText
            android:id="@+id/url"
            style="@style/Field"
            android:hint="https://ade.univ-....fr/jsp/custom/modules/plannings/anonymous_cal.jsp?..."
            android:inputType="textUri" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#F5B14C"
            android:text="Enregistrer le lien et synchroniser"
            android:textAllCaps="false"
            android:textColor="#1A1205"
            android:textStyle="bold" />

        <Button
            android:id="@+id/test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#2A2E4D"
            android:text="Tester la sonnerie (dans 10 s)"
            android:textAllCaps="false"
            android:textColor="#E8E9F5" />
    </LinearLayout>
</ScrollView>
