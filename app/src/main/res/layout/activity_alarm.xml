<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1020"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/ringTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#F5B14C"
        android:textSize="84sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ringInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#C9CCE6"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="56dp"
        android:backgroundTint="#F5B14C"
        android:text="Arrêter"
        android:textAllCaps="false"
        android:textColor="#1A1205"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSnooze"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#2A2E4D"
        android:textAllCaps="false"
        android:textColor="#E8E9F5"
        android:textSize="18sp" />
</LinearLayout>
